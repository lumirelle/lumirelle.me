amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

steps {
  // Code
  ["oxlint"] = Builtins.ox_lint
  ["eslint"] = (Builtins.eslint) {
    batch = false
    glob =
      List(
        // Code
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.tsx",
        "**/*.vue",
        // Configurations
        "**/*.json",
        "**/*.json5",
        "**/*.jsonc",
        "**/*.yaml",
        "**/*.yml",
        "**/*.toml",
        // Documentations
        "**/*.markdown",
        "**/*.md",
        "**/*.mdc",
        "**/*.mdx",
      )
    // ESLint caches per-file results in `.eslintcache` (its default location, gitignored) and
    // invalidates them on content or configuration changes. The content strategy, rather than the
    // default timestamp one, keeps entries valid across a fresh CI checkout.
    check = new CommandSpec {
      command = new Command {
        argv =
          List(
            "eslint",
            "--no-warn-ignored",
            "--cache",
            "--cache-strategy",
            "content",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new CommandSpec {
      command = new Command {
        argv =
          List(
            "eslint",
            "--no-warn-ignored",
            "--fix",
            "--cache",
            "--cache-strategy",
            "content",
            "{{files}}",
          )
      }
      effect = "write"
    }
    depends = List("oxlint")
  }
  ["oxfmt"] = (Builtins.oxfmt) {
    // Formatting runs last: ESLint's fixes are the ones that can leave a file unformatted, and no
    // rule of this repository's config reports what oxfmt would only reformat.
    depends = List("eslint")
  }
  ["tsc"] = (Builtins.tsc) {
    check = new CommandSpec {
      command = new Command {
        argv = List("vue-tsc", "--build", "--noEmit")
      }
      effect = "write"
    }
  }
  // Unused code
  // Disabled as not ready.
  //["knip"] = (Builtins.knip) {
  //  // Disable knip auto-fix, because it's dangerous
  //  fix = null
  //}

  // Configurations
  ["stylua"] = Builtins.stylua
  ["hk"] {
    glob = List("hk.pkl")
    check = new CommandSpec {
      command = new Command { argv = List("hk", "validate") }
      effect = "read"
    }
  }
  ["pkl-format"] = (Builtins.pkl_format) {
    shell = null
    fix = new CommandSpec {
      command = new Command { argv = List("pkl", "format", "--write", "{{ files }}") }
      effect = "write"
    }
  }
}
